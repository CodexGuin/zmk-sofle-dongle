#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {

        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;
        };
        rt_macro: rt_macro {
            compatible = "zmk,behavior-runtime-macro";
            #binding-cells = <1>;
            display-name = "Runtime Macro";
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    macros {
        email: email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Email";
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp D &kp A &kp R &kp R &kp E &kp N &kp S &kp E &kp A &kp H &kp Y &kp O &kp N &kp G &kp L &kp I &kp A &kp N &kp G &kp AT &kp P &kp R &kp O &kp T &kp O &kp N &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
        };

        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

    combos {
        compatible = "zmk,runtime-combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };

        // Runtime placeholders (key positions are fixed at build time): parked
        // on unused layer_3 doing nothing until assigned live with
        // `zmkrt combo set N binding ...` and `zmkrt combo set N layers ...`.
        combo_wf { key-positions = <15 16>; bindings = <&none>; layers = <3>; };
        combo_fp { key-positions = <16 17>; bindings = <&none>; layers = <3>; };
        combo_lu { key-positions = <21 22>; bindings = <&none>; layers = <3>; };
        combo_uy { key-positions = <22 23>; bindings = <&none>; layers = <3>; };
        combo_xc { key-positions = <41 42>; bindings = <&none>; layers = <3>; };
        combo_cd { key-positions = <42 43>; bindings = <&none>; layers = <3>; };
        combo_h_comma { key-positions = <47 48>; bindings = <&none>; layers = <3>; };
        combo_comma_dot { key-positions = <48 49>; bindings = <&none>; layers = <3>; };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp UP       &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp DEL
&kp GRAVE    &kp Q        &kp W        &kp F        &kp P        &kp B        &kp DOWN     &kp J        &kp L        &kp U        &kp Y        &kp SEMI     &kp APOS
&kp LBKT     &hm LGUI A   &hm LALT R   &hm LSHFT S  &hm LCTRL T  &kp G        &kp LEFT     &kp M        &hm RCTRL N  &hm RSHFT E  &hm LALT I   &hm RGUI O   &kp RBKT
&kp MINUS    &kp Z        &kp X        &kp C        &kp D        &kp V        &kp RIGHT    &kp K        &kp H        &kp COMMA    &kp DOT      &kp FSLH     &kp EQUAL
&kp C_PP     &to 1        &to 2        &kp TAB      &mo 2        &kp SPACE    &none        &kp BSPC     &kp RET      &sl 1        &none        &kp BSLH
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "Base";
        };

        layer_1 {
            bindings = <
&kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &none      &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &none
&none      &kp TAB    &kp Q      &kp W      &kp E      &kp R      &none      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P
&none      &kp LSHFT  &kp A      &kp S      &kp D      &kp F      &none      &kp G      &kp H      &kp J      &kp K      &kp L      &to 2
&kp M      &kp LCTRL  &kp Z      &kp X      &kp C      &kp V      &none      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH
&kp C_PP   &to 0      &none      &none      &kp T      &kp SPACE  &none      &none      &kp C_PP   &kp C_PREV &kp C_NEXT &none
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "QWERTY Games";
        };

        layer_2 {
            bindings = <
&kp ESC          &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &mmv MOVE_UP     &kp F6           &kp F7           &kp F8           &kp F9           &kp F10          &kp F11
&email           &rt_macro 0      &rt_macro 1      &rt_macro 2      &kp R            &none            &mmv MOVE_DOWN   &none            &none            &kp UP           &none            &none            &none
&none            &kp A            &kp Z            &kp X            &kp C            &none            &mmv MOVE_LEFT   &none            &kp LEFT         &kp DOWN         &kp RIGHT        &none            &none
&none            &none            &none            &none            &none            &none            &mmv MOVE_RIGHT  &none            &none            &kp HOME         &kp END          &none            &none
&none            &none            &to 0            &none            &none            &kp SPACE        &mkp MB1         &kp RET          &none            &none            &none            &none
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "Utils & Tetrio";
        };

        layer_3 {
            bindings = <
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "layer_3";
        };
    };
};
